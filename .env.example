# Database connection URL (PostgreSQL)
DATABASE_URL="postgresql://username:password@127.0.0.1:5432/doctor_platform"

# JWT configuration (generate a 64-char random hex string)
JWT_SECRET="your_jwt_secret_key_here_min_32_chars"

# Server configuration
PORT=5000
NODE_ENV=development

# Frontend client URL
CLIENT_URL=http://localhost:3000

# AWS S3 Private Storage Configuration (Healthcare Medical Reports)
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-private-medical-reports-bucket
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Payment Gateway Configuration
# Razorpay (India Payments - INR)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe (International / USA Payments - USD)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
